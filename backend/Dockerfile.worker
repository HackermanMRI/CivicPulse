# Worker and scheduler image: the API code plus PyTorch for the zero-shot models (spec §2).
# CPU by default. For the GTX 1660 Super build with:  --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu124
FROM python:3.12-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY backend/requirements.txt backend/requirements-ml.txt /app/
RUN pip install torch==2.6.0 --index-url ${TORCH_INDEX} && pip install -r requirements-ml.txt

COPY backend /app
COPY config /config
ENV CONFIG_PATH=/config/civicpulse.yaml MODELS_DIR=/models

RUN useradd --create-home --uid 10001 civicpulse && mkdir -p /data/uploads && chown -R civicpulse /data /app
USER civicpulse

CMD ["sh", "-c", "rq worker civicpulse --serializer rq.serializers.JSONSerializer --url \"$REDIS_URL\""]
