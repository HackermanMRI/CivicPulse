# Secrets: never commit real environment files or certificates
.env
.env.*
!.env.example
docker/certs/
*.pem
*.key

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend build
node_modules/
dist/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Runtime data: uploads, exports, private datasets, map tiles
backend/uploads/
/uploads/
/exports/
/data/
/tiles/*.pmtiles

# Model weights and evaluation outputs (prepared on your own machine, never committed)
/models/
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.ckpt
backend/eval_results/
