# CivicPulse environment file. Copy to .env and replace EVERY value. Never commit .env (it is gitignored).
# Make random values in PowerShell or any terminal with Python:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (PostgreSQL + PostGIS) -------------------------------------------------------------
# Owner role: runs migrations only. App role: what the API, worker and scheduler use (no UPDATE/DELETE
# on the audit log). Both passwords are set the first time the database volume is created; changing them
# later needs `docker compose down -v` (deletes ALL data) or an ALTER ROLE inside the database.
OWNER_DB_PASSWORD=replace-with-a-long-random-string
APP_DB_PASSWORD=replace-with-another-long-random-string

# --- Security ------------------------------------------------------------------------------------
# Signs the access tokens (JWT HS256) and the OTP hashes. At least 32 characters. Changing it logs everyone out.
SECRET_KEY=replace-with-at-least-32-random-characters
# Salt for hashing IP addresses in the audit log (raw IPs are never stored). At least 16 characters.
IP_HASH_SALT=replace-with-at-least-16-random-characters
# true = the mock OTP code is shown on screen (defence build, Q32) and the API docs are at /api/docs.
# Set false for anything that is not a local demo.
DEV_MODE=true
# Every address people will type in the browser, comma-separated, with https:// and no trailing slash.
# The refresh-cookie endpoint rejects other origins (CSRF guard). Add the laptop's LAN IP for the phones.
FRONTEND_ORIGIN=https://localhost,https://192.168.0.105
# The refresh cookie is sent only over HTTPS. Keep true behind nginx; false only for plain-http local tests.
COOKIE_SECURE=true

# --- Background jobs -----------------------------------------------------------------------------
# false = jobs go to the worker through Redis (normal). true = jobs run inside the API request
# (only for tests or a quick run without the worker container).
JOBS_INLINE=false

# --- ML worker -----------------------------------------------------------------------------------
# cpu or cuda. cuda needs docker-compose.gpu.yml and the CUDA build of torch (TORCH_INDEX below).
DEVICE=cpu
# Which PyTorch wheels the worker image installs. CPU (default, smaller):
TORCH_INDEX=https://download.pytorch.org/whl/cpu
# NVIDIA GPU (GTX 1660 Super):  TORCH_INDEX=https://download.pytorch.org/whl/cu124

# --- DEMO seed data ------------------------------------------------------------------------------
# Password for the three DEMO login accounts (+8801700000001/2/3) made by `python -m app.cli seed-demo`.
# At least 8 characters, not only digits. Only needed when you load the DEMO data.
DEMO_PASSWORD=replace-with-a-demo-password

# --- Optional ------------------------------------------------------------------------------------
# Serve the built frontend from the API itself (only for running without nginx), e.g. ../frontend/dist
# STATIC_DIR=
# API tests need an EMPTY PostGIS database (it is wiped on every run):
# TEST_DATABASE_URL=postgresql+psycopg2://civicpulse_owner:<owner password>@db:5432/civicpulse_test
